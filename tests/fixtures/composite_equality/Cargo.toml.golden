[package]
name = "quire-composite-equality-oracles"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
path = "src/lib.rs"

[dependencies]
quire-contract-runtime = { git = "https://github.com/agent-ix/quire-contract-runtime", rev = "ed0a04b482216b79d3559a6ac59e6e260c5591cf", features = ["exact"] }

[lints.rust]
unsafe_code = "forbid"

[package.metadata.kani]
unstable = { unstable-options = true }
flags = { cbmc-args = ["--max-field-sensitivity-array-size", "1024"] }

[workspace]
