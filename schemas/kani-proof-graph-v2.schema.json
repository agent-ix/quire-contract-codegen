{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-ix.github.io/quire-contract-codegen/schemas/kani-proof-graph-v2.schema.json",
  "title": "Quire Kani proof dependency and subject-binding graph v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "proofId",
    "requirementId",
    "requirementRevision",
    "adapterProfile",
    "backendVersion",
    "backendExecutableSha256",
    "options",
    "readiness",
    "proofExecutionState",
    "subjectArguments",
    "subjectResults",
    "sourceArtifactPath",
    "sourceArtifactSha256",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": {"const": "quire.kani-proof-graph/v2"},
    "proofId": {"type": "string", "minLength": 1},
    "requirementId": {"type": "string", "minLength": 1},
    "requirementRevision": {"type": "integer", "minimum": 1},
    "adapterProfile": {"const": "kani-0.67.0-function-contracts-v2"},
    "backendVersion": {"const": "0.67.0"},
    "backendExecutableSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "options": {
      "type": "array",
      "minItems": 15,
      "items": {"type": "string", "minLength": 1}
    },
    "readiness": {"enum": ["ready", "conditional", "incomplete"]},
    "proofExecutionState": {"const": "not_run"},
    "subjectArguments": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/subjectBinding"}
    },
    "subjectResults": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/subjectBinding"}
    },
    "sourceArtifactPath": {"type": "string", "minLength": 1},
    "sourceArtifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/proofDependency"}
    }
  },
  "definitions": {
    "requirementRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "requirement", "revision"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "requirement": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "dependencyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "kind", "path"],
      "properties": {
        "requirement": {"$ref": "#/definitions/requirementRef"},
        "kind": {"enum": ["input", "state"]},
        "observation": {"enum": ["current", "pre", "post"]},
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "revision"],
      "properties": {
        "document": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "line", "column", "byte_offset"],
      "properties": {
        "source": {"$ref": "#/definitions/sourceIdentity"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "byte_offset": {"type": "integer", "minimum": 0}
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/definitions/sourceLocation"},
        "end": {"$ref": "#/definitions/sourceLocation"}
      }
    },
    "integerBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "minimum", "maximum", "overflow"],
      "properties": {
        "domain": {"enum": ["signed", "unsigned"]},
        "minimum": {"type": "integer"},
        "maximum": {"type": "integer"},
        "overflow": {"enum": ["reject", "saturate"]}
      }
    },
    "subjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency",
        "identifier",
        "role",
        "primitiveType",
        "integerBounds",
        "sourceSpans"
      ],
      "properties": {
        "dependency": {"$ref": "#/definitions/dependencyIdentity"},
        "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "role": {"enum": ["argument", "result"]},
        "primitiveType": {"enum": ["boolean", "i64"]},
        "integerBounds": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/definitions/integerBounds"}
          ]
        },
        "sourceSpans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/sourceSpan"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "primitiveType": {"const": "boolean"},
            "integerBounds": {"type": "null"}
          }
        },
        {
          "properties": {
            "primitiveType": {"const": "i64"},
            "integerBounds": {"$ref": "#/definitions/integerBounds"}
          }
        }
      ]
    },
    "proofDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofId", "kind", "state", "sourceSite"],
      "properties": {
        "proofId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["required", "assumed", "stubbed"]},
        "state": {"enum": ["passed", "missing", "failed", "assumed", "stubbed"]},
        "sourceSite": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(assumption|stub):[0-9a-f]{64}$"}
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "required"},
            "state": {"enum": ["passed", "missing", "failed"]},
            "sourceSite": {"type": "null"}
          }
        },
        {
          "properties": {
            "kind": {"const": "assumed"},
            "state": {"const": "assumed"},
            "sourceSite": {"type": "string", "pattern": "^assumption:[0-9a-f]{64}$"}
          }
        },
        {
          "properties": {
            "kind": {"const": "stubbed"},
            "state": {"const": "stubbed"},
            "sourceSite": {"type": "string", "pattern": "^stub:[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
