{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agent-ix/quire-contract-codegen/schemas/foundation-evidence-input-v1.schema.json",
  "title": "Codegen foundation evidence input v1",
  "description": "SPDX-License-Identifier: MIT OR Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRevision", "sourceState", "phase", "gateScripts", "commands", "tools", "dependencies"],
  "properties": {
    "schemaVersion": {"const": "quire.codegen-foundation-evidence-input/v1"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "sourceState": {"enum": ["clean", "modified"]},
    "phase": {"const": "foundation"},
    "gateScripts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(scripts|tools)/.+$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo", "jsonschema", "python", "python-packages", "quire", "rustc", "rust-msrv"],
      "properties": {
        "cargo": {"type": "string", "minLength": 1},
        "jsonschema": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "python-packages": {"type": "string", "minLength": 1},
        "quire": {"type": "string", "minLength": 1},
        "rustc": {"type": "string", "minLength": 1},
        "rust-msrv": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pgm01", "irCorpus", "runtimeCandidateRevision"],
      "properties": {
        "pgm01": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "candidateRevision", "envelopeSchema", "envelopeSchemaDigest", "schemaPath", "schemaDigest", "validatorPath", "validatorDigest", "validatorRevision"],
          "properties": {
            "policy": {"const": "ix://agent-ix/quire-contract-ir/PGM-01"},
            "candidateRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            "envelopeSchema": {"const": "quire.derivation-evidence/v1"},
            "envelopeSchemaDigest": {"$ref": "#/definitions/digest"},
            "schemaPath": {"type": "string", "minLength": 1},
            "schemaDigest": {"$ref": "#/definitions/digest"},
            "validatorPath": {"type": "string", "minLength": 1},
            "validatorDigest": {"$ref": "#/definitions/digest"},
            "validatorRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
          }
        },
        "irCorpus": {"type": "string", "minLength": 1},
        "runtimeCandidateRevision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    }
  },
  "definitions": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
