{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agent-ix/quire-contract-codegen/schemas/oracle-source-map-v1.schema.json",
  "title": "Quire generated oracle source map v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "artifactPath",
      "role",
      "startLine",
      "endLine",
      "requirementId",
      "requirementRevision",
      "clauseId"
    ],
    "properties": {
      "artifactPath": {"type": "string", "minLength": 1},
      "role": {"enum": ["clause", "oracle_evaluation", "implication_consequent"]},
      "startLine": {"type": "integer", "minimum": 1},
      "endLine": {"type": "integer", "minimum": 1},
      "requirementId": {"type": "string", "minLength": 1},
      "requirementRevision": {"type": "integer", "minimum": 1},
      "clauseId": {"type": "string", "minLength": 1}
    }
  }
}
