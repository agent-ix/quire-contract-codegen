{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agent-ix/quire-contract-codegen/schemas/oracle-source-map-v1.schema.json",
  "title": "Quire generated oracle source map v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "artifactPath",
      "role",
      "startLine",
      "endLine",
      "packageId",
      "requirementId",
      "requirementRevision",
      "clauseId"
    ],
    "properties": {
      "artifactPath": {"type": "string", "minLength": 1},
      "role": {"enum": ["clause", "oracle_evaluation", "implication_consequent"]},
      "startLine": {"type": "integer", "minimum": 1},
      "endLine": {"type": "integer", "minimum": 1},
      "packageId": {"type": "string", "minLength": 1},
      "requirementId": {"type": "string", "minLength": 1},
      "requirementRevision": {"type": "integer", "minimum": 1},
      "clauseId": {"type": "string", "minLength": 1},
      "expectedConsequents": {"type": "integer", "minimum": 0},
      "probe": {
        "type": "object", "additionalProperties": false,
        "required": ["line", "startColumn", "endColumn"],
        "properties": {
          "line": {"type": "integer", "minimum": 1},
          "startColumn": {"type": "integer", "minimum": 1},
          "endColumn": {"type": "integer", "minimum": 2}
        }
      }
    },
    "if": {"properties": {"role": {"const": "clause"}}},
    "then": {"required": ["expectedConsequents"], "not": {"required": ["probe"]}},
    "else": {"required": ["probe"], "not": {"required": ["expectedConsequents"]}}
  }
}
